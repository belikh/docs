{
  "name": "@belikh/jupiter-docs",
  "version": "2.0.0",
  "description": "Jupiter docs generator: one Markdown source (docs-src) becomes a themed static site, repo Markdown and a LaTeX/PDF document. The design system is read from a release download (vendor/design), not installed.",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "jupiter-docs": "./bin/jupiter-docs.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "latex",
    "skill",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "prepack": "node ../../scripts/stage-package.mjs"
  },
  "dependencies": {
    "markdown-it": "14.3.3",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belikh/docs.git",
    "directory": "packages/docs"
  }
}
